{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Vibe Kit Event Ledger Entry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "seq",
    "event_id",
    "event_type",
    "phase",
    "occurred_at",
    "imported_at",
    "actor",
    "commit",
    "evidence_ref",
    "source",
    "details",
    "prev_hash",
    "event_hash"
  ],
  "properties": {
    "schema": {
      "const": 1
    },
    "seq": {
      "type": "integer",
      "minimum": 1
    },
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "event_type": {
      "type": "string",
      "minLength": 1
    },
    "phase": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9]{2}$"
    },
    "occurred_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "imported_at": {
      "type": "string",
      "format": "date-time"
    },
    "actor": {
      "type": "string",
      "minLength": 1
    },
    "commit": {
      "type": [
        "string",
        "null"
      ]
    },
    "evidence_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "details": {
      "type": "object"
    },
    "prev_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "event_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
